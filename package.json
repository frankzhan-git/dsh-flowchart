{
  "name": "dsh-flowchart",
  "version": "0.2.6",
  "description": "流程图：会话输入框内绘制 Mermaid 流程图，实时生成标准 Mermaid 代码，一键复制或插入 dsh 会话",
  "license": "MIT",
  "author": "FrankZhan",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankzhan-git/dsh-flowchart.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "mermaid",
    "flowchart"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "verify": "node scripts/verify-shapes.mjs && node scripts/verify-codegen.mjs && node scripts/verify-interactions.mjs && node scripts/verify-storage.mjs && node scripts/verify-host-storage.mjs && node scripts/verify-adapter-contract.mjs && node scripts/verify-protocol.mjs && node scripts/verify-perf.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "mermaid": "^11.4.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
